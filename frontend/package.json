{
  "name": "@intersect.mbo/govtool-voting-pillar",
  "description": "Voting Pillar of the GovTool project",
  "version": "0.0.1",
  "license": "MIT",
  "type": "module",
  "main": "./dist/@intersect.mbo/govtool-voting-pillar.umd.js",
  "module": "./dist/@intersect.mbo/govtool-voting-pillar.es.js",
  "types": "./dist/export.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "node": "./dist/@intersect.mbo/govtool-voting-pillar.umd.js",
      "types": "./dist/export.d.ts",
      "import": {
        "types": "./dist/export.d.ts",
        "default": "./dist/@intersect.mbo/govtool-voting-pillar.es.js"
      },
      "require": {
        "types": "./dist/export.d.ts",
        "default": "./dist/@intersect.mbo/govtool-voting-pillar.umd.js"
      }
    },
    "./package.json": "./package.json",
    "./dist/*": "./dist/*",
    "./styles": "./dist/export.css"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/IntersectMBO/govtool-voting-pillar.git"
  },
  "keywords": [
    "GovTool",
    "Voting",
    "Pillar"
  ],
  "author": "IntersectMBO",
  "bugs": {
    "url": "https://github.com/IntersectMBO/govtool-voting-pillar/issues"
  },
  "homepage": "https://github.com/IntersectMBO/govtool-voting-pillar#readme",
  "scripts": {
    "eject": "react-scripts eject",
    "format": "prettier --write src/**/*.ts src/**/*.tsx",
    "lint": "eslint src/**/*.ts src/**/*.tsx --report-unused-disable-directives --max-warnings 0",
    "prepare": "husky",
    "start": "GENERATE_SOURCEMAP=false react-scripts start",
    "storybook:build": "storybook build",
    "storybook:preview": "storybook dev -p 6006",
    "test": "jest",
    "test:watch": "jest --watch",
    "tsc": "npx tsc --noEmit --skipLibCheck",
    "watch": "rollup -c --bundleConfigAsCjs --watch",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:watch": "vite build --watch",
    "clean": "rimraf dist",
    "prebuild": "yarn clean",
    "prepublishOnly": "yarn build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@emotion/react": "^11.13.0",
    "@emotion/styled": "^11.13.0",
    "@hookform/resolvers": "^3.9.0",
    "@mattpiz/tlock-js": "0.10.0",
    "@mui/icons-material": "^6.1.5",
    "@mui/material": "^6.1.5",
    "@storybook/addon-actions": "^8.2.8",
    "@storybook/addon-essentials": "^8.2.8",
    "@storybook/addon-links": "^8.2.8",
    "@storybook/react-webpack5": "^8.2.8",
    "@types/jsonld": "^1.5.15",
    "axios": "^1.8.3",
    "blakejs": "^1.2.1",
    "cip-179": "0.2.0",
    "date-fns": "^4.1.0",
    "jsonld": "^8.3.3",
    "keen-slider": "^6.8.5",
    "react-diff-view": "^3.2.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.0",
    "react-markdown": "^9.0.1",
    "react-query": "^3.39.3",
    "react-router-dom": "^6.13.0",
    "react-scripts": "5.0.1",
    "unidiff": "^1.0.4",
    "vite-plugin-dts": "^4.5.3",
    "yup": "^1.4.0"
  },
  "devDependencies": {
    "@babel/core": "^7.0.0-0",
    "@babel/plugin-proposal-private-property-in-object": "^7.21.0",
    "@babel/plugin-syntax-flow": "^7.14.5",
    "@babel/plugin-transform-react-jsx": "^7.14.9",
    "@babel/plugin-transform-runtime": "^7.25.9",
    "@babel/runtime": "^7.26.0",
    "@babel/runtime-corejs3": "^7.26.0",
    "@chromatic-com/storybook": "^1.6.1",
    "@storybook/addon-interactions": "^8.2.8",
    "@storybook/addon-onboarding": "^8.2.8",
    "@storybook/addon-themes": "^8.2.8",
    "@storybook/blocks": "^8.2.8",
    "@storybook/preset-create-react-app": "^8.2.8",
    "@storybook/react": "^8.2.8",
    "@storybook/test": "^8.2.8",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.4.8",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^13.5.0",
    "@types/jest": "^27.5.2",
    "@types/node": "^16.7.13",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^8.57.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jest": "^28.8.0",
    "eslint-plugin-jsx-a11y": "^6.9.0",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-storybook": "^0.8.0",
    "husky": "^9.1.4",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jsdom": "^24.1.1",
    "lint-staged": "^15.2.8",
    "postcss": "^8.4.47",
    "prettier": "^3.3.3",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "rollup": "^4.19.1",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "storybook": "^8.2.8",
    "ts-jest": "^29.2.4",
    "tslib": "^2.8.1",
    "typescript": "^4.4.2",
    "vite": "^6.2.0",
    "webpack": "^5.93.0"
  },
  "peerDependencies": {
    "@fontsource/roboto": "^5.0.14",
    "@mui/icons-material": "^6.1.5",
    "@mui/material": "^6.1.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "packageManager": "yarn@4.8.1"
}
